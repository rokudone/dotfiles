{
  "title": "util",
  "rules": [
    {
      "description": "[windows] Cmdキーを単体で押したときに、英数・かなキーを送信する（ターミナル用）",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_command", "modifiers": { "optional": [ "any" ] }
          },
          "parameters": {
            "basic.to_if_held_down_threshold_milliseconds": 100
          },
          "to": [ { "key_code": "left_command", "lazy": true } ],
          "to_if_held_down": [ { "key_code": "left_command" } ],
          "to_if_alone": [ { "key_code": "japanese_eisuu" } ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_command", "modifiers": { "optional": [ "any" ] }
          },
          "parameters": {
            "basic.to_if_held_down_threshold_milliseconds": 100
          },
          "to": [ { "key_code": "right_command", "lazy": true } ],
          "to_if_held_down": [ { "key_code": "right_command" } ],
          "to_if_alone": [ { "key_code": "japanese_kana" } ]
        }
      ]
    },
    {
      "description": "[windows] シフトキーを単体で押したときに、英数・かなキーを送信する。（左シフトキーは英数、右シフトキーはかな） (rev 3)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_shift", "modifiers": { "optional": [ "any" ] }
          },
          "parameters": {
            "basic.to_if_held_down_threshold_milliseconds": 100
          },
          "to": [ { "key_code": "left_shift", "lazy": true } ],
          "to_if_held_down": [ { "key_code": "left_shift" } ],
          "to_if_alone": [ { "key_code": "japanese_eisuu" } ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_shift", "modifiers": { "optional": [ "any" ] }
          },
          "parameters": {
            "basic.to_if_held_down_threshold_milliseconds": 100
          },
          "to": [ { "key_code": "right_shift", "lazy": true } ],
          "to_if_held_down": [ { "key_code": "right_shift" } ],
          "to_if_alone": [ { "key_code": "japanese_kana" } ]
        }
      ]
    },
    {
      "description": "[util] Send jis_eisuu when type esc",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "escape" },
          "to": [
            { "key_code": "escape" },
            { "select_input_source": { "language": "^en$" } }
          ]
        }
      ]
    },
    {
      "description": "[util] Send jis_eisuu when activate raycast",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "spacebar", "modifiers": { "mandatory": [ "option" ], "optional": [ "any" ] } },
          "to": [
            { "key_code": "japanese_eisuu" },
            { "key_code": "spacebar", "modifiers": [ "option" ] }
          ]
        }
      ]
    },
    {
      "description": "[util] ctl + [ to escape on vscode",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "open_bracket", "modifiers": { "mandatory": [ "control" ] } },
          "to": [
            { "key_code": "escape" },
            { "select_input_source": { "language": "^en$" } }
          ]
        }
      ]
    },
    {
      "description": "[util] Cmd + [ to escape on vscode",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "open_bracket", "modifiers": { "mandatory": [ "command" ]} },
          "to": [
            { "key_code": "escape" },
            { "select_input_source": { "language": "^en$" } }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "com\\.microsoft\\.VSCode",
                "com\\.todesktop\\.230313mzl4w4u92"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "[util] ctl + enter to ctrl + v on vscode",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "return_or_enter", "modifiers": { "mandatory": [ "control" ] } },
          "to": [
            { "key_code": "v", "modifiers": [ "left_control" ] }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.jetbrains\\.rubymine$",
                "^co\\.zeit\\.hyperterm$",
                "^co\\.zeit\\.hyper$",
                "^org\\.alacritty$",
                "^dev\\.warp\\.Warp-Stable$",
                "^net\\.kovidgoyal\\.kitty$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.github\\.wez\\.wezterm$",
                "^com\\.raphaelamorim\\.rio$"

              ]
            }
          ]
        }
      ]
    },
    {
      "description": "[util] Quit application by pressing command-q twice",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "variable_if",
              "name": "command-q",
              "value": 1
            }
          ],
          "from": {
            "key_code": "q",
            "modifiers": { "mandatory": [ "command" ], "optional": [ "caps_lock" ]
            }
          },
          "to": [
            { "key_code": "q", "modifiers": [ "left_command" ] }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "q", "modifiers": { "mandatory": [ "command" ], "optional": [ "caps_lock" ] }
          },
          "to": [
            { "set_variable": { "name": "command-q", "value": 1 } }
          ],
          "to_delayed_action": {
            "to_if_invoked": [ { "set_variable": { "name": "command-q", "value": 0 } }
            ],
            "to_if_canceled": [ { "set_variable": { "name": "command-q", "value": 0 } } ]
          },
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.jetbrains\\.rubymine$",
                "^co\\.zeit\\.hyperterm$",
                "^co\\.zeit\\.hyper$",
                "^org\\.alacritty$",
                "^dev\\.warp\\.Warp-Stable$",
                "^net\\.kovidgoyal\\.kitty$",
                "^com\\.todesktop\\.230313mzl4w4u92$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.github\\.wez\\.wezterm$",
                "^com\\.raphaelamorim\\.rio$"

              ]
            }
          ]
        }
      ]
    },
    {
      "description": "[util] cmd + hjkl to cmd + shift + opt + arrows on cmux",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.cmuxterm\\.app$", "^com\\.cmuxterm\\.app\\.nightly$"] }],
          "from": { "key_code": "h", "modifiers": { "mandatory": [ "command" ], "optional": [ "shift" ] } },
          "to": [{ "key_code": "left_arrow", "modifiers": [ "command", "shift", "option" ] }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.cmuxterm\\.app$", "^com\\.cmuxterm\\.app\\.nightly$"] }],
          "from": { "key_code": "j", "modifiers": { "mandatory": [ "command" ], "optional": [ "shift" ] } },
          "to": [{ "key_code": "down_arrow", "modifiers": [ "command", "shift", "option" ] }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.cmuxterm\\.app$", "^com\\.cmuxterm\\.app\\.nightly$"] }],
          "from": { "key_code": "k", "modifiers": { "mandatory": [ "command" ], "optional": [ "shift" ] } },
          "to": [{ "key_code": "up_arrow", "modifiers": [ "command", "shift", "option" ] }]
        },
        {
          "type": "basic",
          "conditions": [{ "type": "frontmost_application_if", "bundle_identifiers": ["^com\\.cmuxterm\\.app$", "^com\\.cmuxterm\\.app\\.nightly$"] }],
          "from": { "key_code": "l", "modifiers": { "mandatory": [ "command" ], "optional": [ "shift" ] } },
          "to": [{ "key_code": "right_arrow", "modifiers": [ "command", "shift", "option" ] }]
        }
      ]
    },
    {
      "description": "[util] disable cmd + shift + q",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "q", "modifiers": { "mandatory": [ "command", "shift" ] } },
          "to": [
            { "key_code": "q", "modifiers": { "mandatory": [ "command", "shift" ] } }
          ]
        }
      ]
    },
    {
      "description": "[util] Send jis_eisuu + ctl + q on terminal",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "q", "modifiers": { "mandatory": [ "control" ], "optional": [ "any" ] } },
          "to": [
            { "select_input_source": { "language": "^en$" } },
            { "key_code": "q", "modifiers": [ "control" ] }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.jetbrains\\.rubymine$",
                "^co\\.zeit\\.hyperterm$",
                "^co\\.zeit\\.hyper$",
                "^org\\.alacritty$",
                "^dev\\.warp\\.Warp-Stable$",
                "^net\\.kovidgoyal\\.kitty$",
                "^com\\.todesktop\\.230313mzl4w4u92$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.github\\.wez\\.wezterm$",
                "^com\\.raphaelamorim\\.rio$",
                "^com\\.cmuxterm\\.app$",
                "^com\\.cmuxterm\\.app\\.nightly$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "[util] cmd+tab to ctrl+cmd+tab, cmd+shift+tab to ctrl+cmd+shift+tab on terminal (herdr tab move)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "tab", "modifiers": { "mandatory": [ "command" ] } },
          "to": [
            { "key_code": "tab", "modifiers": [ "control", "command" ] }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.jetbrains\\.rubymine$",
                "^co\\.zeit\\.hyperterm$",
                "^co\\.zeit\\.hyper$",
                "^org\\.alacritty$",
                "^dev\\.warp\\.Warp-Stable$",
                "^net\\.kovidgoyal\\.kitty$",
                "^com\\.todesktop\\.230313mzl4w4u92$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.github\\.wez\\.wezterm$",
                "^com\\.raphaelamorim\\.rio$",
                "^com\\.cmuxterm\\.app$",
                "^com\\.cmuxterm\\.app\\.nightly$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": { "key_code": "tab", "modifiers": { "mandatory": [ "command", "shift" ] } },
          "to": [
            { "key_code": "tab", "modifiers": [ "control", "command", "shift" ] }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.googlecode\\.iterm2$",
                "^com\\.jetbrains\\.rubymine$",
                "^co\\.zeit\\.hyperterm$",
                "^co\\.zeit\\.hyper$",
                "^org\\.alacritty$",
                "^dev\\.warp\\.Warp-Stable$",
                "^net\\.kovidgoyal\\.kitty$",
                "^com\\.todesktop\\.230313mzl4w4u92$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.github\\.wez\\.wezterm$",
                "^com\\.raphaelamorim\\.rio$",
                "^com\\.cmuxterm\\.app$",
                "^com\\.cmuxterm\\.app\\.nightly$"
              ]
            }
          ]
        }
      ]
    }
  ]
}
