  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/takuma/projects/dotfiles/bin/notify-osc777"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -n --arg ctx \"$(printf 'CPU load (1/5/15m):%s\\n' \"$(sysctl -n vm.loadavg | tr -d '{}')\"; ps -Ao %cpu,comm -r | awk 'NR>1 && $1>3.0 {printf \"  %5s%%  %s\\n\",$1,$2} NR>8{exit}')\" '{hookSpecificOutput:{hookEventName:\"PreToolUse\",additionalContext:(\"[bench pre-check] \" + $ctx)}}'",
            "if": "Bash(*madara bench*)",
            "statusMessage": "Checking CPU load before bench"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/takuma/.claude/hooks/detect-fabricated-user-turn.sh",
            "statusMessage": "Checking for fabricated user turns"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '<zero-based-check>それを0ベースで一から書くときにもそう書くか。</zero-based-check>'"
          }
        ]
      }
    ]
  },
